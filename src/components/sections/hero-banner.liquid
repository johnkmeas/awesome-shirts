<div class="relative flex items-center justify-center min-h-[400px] md:min-h-[600px] overflow-hidden">
  {%- if section.settings.image != blank -%}
    <img
      class="absolute inset-0 object-cover w-full h-full"
      src="{{ section.settings.image | image_url: width: 1920 }}"
      alt="{{ section.settings.image.alt | escape }}"
      loading="lazy"
      width="1920"
      height="1080">
  {%- else -%}
    <div class="absolute inset-0 bg-gray-300"></div>
  {%- endif -%}

  {%- if section.settings.overlay_opacity > 0 -%}
    <div class="absolute inset-0 bg-black" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
  {%- endif -%}

  <div class="relative z-10 flex flex-col items-center px-4 py-12 text-center max-w-3xl mx-auto">
    {%- if section.settings.title != blank -%}
      <h2 class="text-4xl font-bold md:text-5xl lg:text-6xl text-white">
        {{ section.settings.title }}
      </h2>
    {%- endif -%}

    {%- if section.settings.description != blank -%}
      <p class="mt-4 text-lg md:text-xl text-white/90">
        {{ section.settings.description }}
      </p>
    {%- endif -%}

    {%- if section.settings.cta_text != blank -%}
      <a
        href="{{ section.settings.cta_link }}"
        class="inline-block px-8 py-3 mt-8 text-base font-medium text-white bg-gray-900 border rounded cursor-pointer hover:bg-gray-700">
        {{ section.settings.cta_text }}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40,
      "unit": "%"
    },
    {
      "type": "text",
      "id": "title",
      "default": "Welcome to Our Store",
      "label": "Title"
    },
    {
      "type": "textarea",
      "id": "description",
      "default": "Discover our latest collection of awesome shirts.",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "cta_text",
      "default": "Shop Now",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
